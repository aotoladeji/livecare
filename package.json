{
  "name": "livecare-website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "firebase": "^12.12.1",
    "react": "^18.2.0",
    "react-countup": "^6.5.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^9.5.3",
    "react-router-dom": "^6.21.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "firebase:whoami": "npx --yes firebase-tools login:list",
    "firebase:login": "npx --yes firebase-tools login",
    "firebase:use": "npx --yes firebase-tools use live-care-app",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules",
    "firebase:repair": "npx --yes firebase-tools use live-care-app && npx --yes firebase-tools deploy --only firestore:rules",
    "postinstall": "chmod +x node_modules/.bin/react-scripts"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
